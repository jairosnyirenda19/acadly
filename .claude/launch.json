{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "acadly-console",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--dir",
        "app.frontend",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "acadly-portal",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--dir",
        "app.frontend",
        "dev:portal"
      ],
      "port": 5174
    },
    {
      "name": "acadly-student",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--dir",
        "app.frontend",
        "dev:student"
      ],
      "port": 5175
    },
    {
      "name": "acadly-api-local",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "app.backend/artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8010"
      ],
      "port": 8010
    },
    {
      "name": "acadly-console-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set ACADLY_API=http://127.0.0.1:8010&& corepack pnpm --dir app.frontend dev"
      ],
      "port": 5173
    }
  ]
}