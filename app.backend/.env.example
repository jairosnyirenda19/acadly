APP_NAME="Acadly IQ-X"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://api.acadly-iq-x.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PostgreSQL. Two roles: the application role cannot bypass row-level security;
# the owner role runs migrations. See infra/README-database.md.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=acadly_db
DB_USERNAME=acadly_app
DB_PASSWORD=
DB_OWNER_USERNAME=acadly_owner
DB_OWNER_PASSWORD=
DB_TEST_DATABASE=acadly_test_db

# Where people use the console. Password reset links point here.
ACADLY_LICENCE_PUBLIC_KEY=
ACADLY_TIMEZONE=Africa/Blantyre
ACADLY_SCHOOL_NAME="Sunrise Academy"
ACADLY_FRONTEND_URL=http://localhost:5173

# Documents. A server needs its own key: base64 of 32 random bytes. A development
# machine with none derives one. ACADLY_VIRUS_SCAN is clamav on a server; off is
# accepted only on a development machine. With neither, uploads are refused.
ACADLY_DOCUMENTS_KEY=
ACADLY_VIRUS_SCAN=off
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Development administrator, made by php artisan db:seed (local only).
# Choose your own values; the password needs at least 12 characters.
DEV_ADMIN_EMAIL=
DEV_ADMIN_NAME=
DEV_ADMIN_PASSWORD=
# View as (development only): step into another account to test it.
DEV_VIEW_AS=false
DEV_VIEW_AS_MINUTES=60

# Text messages: "log" writes each one to the log and sends nothing; "school" sends through the provider chosen on the Messages page.
ACADLY_SMS_DRIVER=log
