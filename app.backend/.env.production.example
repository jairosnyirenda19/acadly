# The settings of one school on its server (D-112). Copy to /srv/acadly/<school>/shared/.env,
# chmod 600, owned by the school's user. Keep a copy of the whole file in the password
# store: APP_KEY and ACADLY_DOCUMENTS_KEY cannot be made again, and without them a
# restored school cannot read its documents.
# php artisan acadly:preflight checks every line that matters.

APP_NAME="Acadly IQ-X"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show, once.
APP_KEY=
APP_URL=https://console.sunrise.example
ACADLY_VERSION=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Sign-in cookies travel over HTTPS only, on the school's own host names.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=console.sunrise.example,parents.sunrise.example,students.sunrise.example

# The web server in front (nginx on the same machine).
ACADLY_TRUSTED_PROXIES=127.0.0.1

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# The database: the application role (rows only) and the owner role (releases only).
# See infra/README-database.md.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=acadly_sunrise
DB_USERNAME=acadly_app
DB_PASSWORD=
DB_OWNER_USERNAME=acadly_owner
DB_OWNER_PASSWORD=

# The school.
ACADLY_SCHOOL_NAME="Sunrise Academy"
ACADLY_TIMEZONE=Africa/Blantyre
ACADLY_LICENCE_PUBLIC_KEY=
ACADLY_FRONTEND_URL=https://console.sunrise.example
ACADLY_PORTAL_URL=https://parents.sunrise.example
ACADLY_STUDENT_URL=https://students.sunrise.example

# Documents: their own key (head -c 32 /dev/urandom | base64), and a virus scan on every upload.
ACADLY_DOCUMENTS_KEY=
ACADLY_VIRUS_SCAN=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
ACADLY_SOFFICE_BIN=/usr/bin/soffice

# The document engine: the Python made by the release (see infra/README-deploy.md).
ACADLY_PYTHON_BIN=/srv/acadly/sunrise/shared/python/bin/python

# Text messages go through the provider chosen on the Messages page.
ACADLY_SMS_DRIVER=school

# Email.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${ACADLY_SCHOOL_NAME}"

# Development only: never on a school's server.
DEV_VIEW_AS=false
