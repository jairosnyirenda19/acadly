{
    "openapi": "3.1.2",
    "info": {
        "title": "Acadly IQ-X",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "https://api.acadly-iq-x.test/api"
        }
    ],
    "paths": {
        "/v1/me/context": {
            "get": {
                "operationId": "me.context",
                "description": "The school, its divisions and campuses, the modules that are on, the\nwording, the account's permissions per scope and the navigation\n(docs/architecture/03-deployment-campus-access.md \u00a75.8). Divisions,\ncampuses, wording and navigation are empty until the stages that build\nthem. The screens use this to decide what to offer; the server checks\nevery request again.",
                "summary": "What the screens are built from",
                "tags": [
                    "Context"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "email"
                                            ]
                                        },
                                        "school": {
                                            "type": "object",
                                            "properties": {
                                                "name": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "name"
                                            ]
                                        },
                                        "licence": {
                                            "type": "object",
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "enum": [
                                                        "valid",
                                                        "expired",
                                                        "missing",
                                                        "development"
                                                    ]
                                                },
                                                "read_only": {
                                                    "type": "boolean"
                                                }
                                            },
                                            "required": [
                                                "status",
                                                "read_only"
                                            ]
                                        },
                                        "modules": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "divisions": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": [
                                                    "id",
                                                    "name"
                                                ]
                                            }
                                        },
                                        "campuses": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": [
                                                    "id",
                                                    "name"
                                                ]
                                            }
                                        },
                                        "vocabulary": {
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "string"
                                            }
                                        },
                                        "navigation": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "key": {
                                                        "type": "string"
                                                    },
                                                    "permission": {
                                                        "type": "string"
                                                    }
                                                },
                                                "required": [
                                                    "key",
                                                    "permission"
                                                ]
                                            }
                                        },
                                        "grants": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "permission": {
                                                        "type": "string"
                                                    },
                                                    "scope_type": {
                                                        "type": "string",
                                                        "enum": [
                                                            "institution",
                                                            "division",
                                                            "campus",
                                                            "class"
                                                        ]
                                                    },
                                                    "scope_id": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "permission",
                                                    "scope_type",
                                                    "scope_id"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "school",
                                        "licence",
                                        "modules",
                                        "divisions",
                                        "campuses",
                                        "vocabulary",
                                        "navigation",
                                        "grants"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/csrf-cookie": {
            "get": {
                "operationId": "sanctum.csrf-cookie",
                "summary": "Return an empty response simply to trigger the storage of the CSRF cookie in the browser",
                "tags": [
                    "CsrfCookie"
                ],
                "responses": {
                    "204": {
                        "description": "No content\n\nNo content",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {}
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/health": {
            "get": {
                "operationId": "kernel.health",
                "description": "Reports that the service is reachable. It discloses nothing about the\nrelease, the modules or the technology in use, and requires no\nauthentication.",
                "summary": "Service status",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/me": {
            "get": {
                "operationId": "me",
                "description": "Grants list each permission with the scope it is held at. The screens\nuse them to decide what to offer; the server checks every request again.",
                "summary": "The signed-in account and its access",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "email"
                                            ]
                                        },
                                        "grants": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "permission": {
                                                        "type": "string"
                                                    },
                                                    "scope_type": {
                                                        "type": "string",
                                                        "enum": [
                                                            "institution",
                                                            "division",
                                                            "campus",
                                                            "class"
                                                        ]
                                                    },
                                                    "scope_id": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "permission",
                                                    "scope_type",
                                                    "scope_id"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "grants"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/modules": {
            "get": {
                "operationId": "modules.index",
                "description": "`state` names the first condition that is not met: `not_offered`,\n`not_licensed` or `switched_off`.",
                "summary": "The modules in this build and whether each is on",
                "tags": [
                    "Modules"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "licence": {
                                            "type": "object",
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "enum": [
                                                        "valid",
                                                        "expired",
                                                        "missing",
                                                        "development"
                                                    ]
                                                },
                                                "licensee": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "expires_at": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "status",
                                                "licensee",
                                                "expires_at"
                                            ]
                                        },
                                        "modules": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "key": {
                                                        "type": "string"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    },
                                                    "tier": {
                                                        "type": "string",
                                                        "enum": [
                                                            "core",
                                                            "optional"
                                                        ]
                                                    },
                                                    "state": {
                                                        "type": "string",
                                                        "enum": [
                                                            "active",
                                                            "not_installed",
                                                            "not_offered",
                                                            "not_licensed",
                                                            "switched_off"
                                                        ]
                                                    },
                                                    "switched_on": {
                                                        "type": "boolean"
                                                    }
                                                },
                                                "required": [
                                                    "key",
                                                    "name",
                                                    "tier",
                                                    "state",
                                                    "switched_on"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "licence",
                                        "modules"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/AuthorizationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/modules/{key}": {
            "put": {
                "operationId": "modules.update",
                "description": "A reason is required and is kept in the audit trail.",
                "summary": "Switch a module on or off",
                "tags": [
                    "Modules"
                ],
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "reason": {
                                        "type": "string",
                                        "maxLength": 1000
                                    }
                                },
                                "required": [
                                    "enabled",
                                    "reason"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "key": {
                                            "type": "string"
                                        },
                                        "enabled": {
                                            "type": "boolean"
                                        }
                                    },
                                    "required": [
                                        "key",
                                        "enabled"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/me/notifications": {
            "get": {
                "operationId": "me.notifications",
                "summary": "The signed-in person's in-app notices, newest first",
                "tags": [
                    "Notifications"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "unread": {
                                            "type": "integer"
                                        },
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "topic": {
                                                        "type": "string"
                                                    },
                                                    "subject": {
                                                        "type": "string"
                                                    },
                                                    "body": {
                                                        "type": "string"
                                                    },
                                                    "action_url": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    },
                                                    "created_at": {
                                                        "type": "string"
                                                    },
                                                    "read_at": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                },
                                                "required": [
                                                    "id",
                                                    "topic",
                                                    "subject",
                                                    "body",
                                                    "action_url",
                                                    "created_at",
                                                    "read_at"
                                                ]
                                            }
                                        }
                                    },
                                    "required": [
                                        "unread",
                                        "items"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/me/notifications/{id}/read": {
            "post": {
                "operationId": "me.notifications.read",
                "summary": "Marks one of the person's own notices as read",
                "tags": [
                    "Notifications"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFoundHttpException"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/v1/auth/forgot-password": {
            "post": {
                "operationId": "auth.forgot-password",
                "description": "The response is the same whether or not an account exists for the\naddress.",
                "summary": "Request a password reset link",
                "tags": [
                    "PasswordReset"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "maxLength": 255
                                    }
                                },
                                "required": [
                                    "email"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "integer",
                                    "const": 202
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/reset-password": {
            "post": {
                "operationId": "auth.reset-password",
                "summary": "Set a new password with a reset link",
                "tags": [
                    "PasswordReset"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "token": {
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "maxLength": 255
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "password_confirmation": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "token",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/ready": {
            "get": {
                "operationId": "kernel.ready",
                "description": "Ready when the database has been brought into line with this release:\nthe notice catalogue it holds matches the one in the code (04 \u00a79). It\ndiscloses nothing else and requires no authentication.",
                "summary": "Readiness",
                "tags": [
                    "Readiness"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "integer",
                                    "const": 200
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/school": {
            "get": {
                "operationId": "kernel.school",
                "description": "The sign-in screens show the school's name. It requires no\nauthentication and discloses nothing else.",
                "summary": "The school this deployment serves",
                "tags": [
                    "School"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "name"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/auth/sign-in": {
            "post": {
                "operationId": "auth.sign-in",
                "description": "Starts a session for the account. The response is the same as GET /me.",
                "summary": "Sign in",
                "tags": [
                    "SignIn"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "maxLength": 255
                                    },
                                    "password": {
                                        "type": "string",
                                        "maxLength": 255
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "user": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "email": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "id",
                                                "name",
                                                "email"
                                            ]
                                        },
                                        "grants": {
                                            "type": "array",
                                            "items": {}
                                        }
                                    },
                                    "required": [
                                        "user",
                                        "grants"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/v1/auth/sign-out": {
            "post": {
                "operationId": "auth.sign-out",
                "description": "Ends the session.",
                "summary": "Sign out",
                "tags": [
                    "SignOut"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        }
    },
    "components": {
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "NotFoundHttpException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            },
            "AuthorizationException": {
                "description": "Authorization error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}