{
    "openapi": "3.1.2",
    "info": {
        "title": "Acadly IQ-X",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "https://api.acadly-iq-x.test/api"
        }
    ],
    "paths": {
        "/v1/health": {
            "get": {
                "operationId": "kernel.health",
                "description": "Reports that the service is reachable. It discloses nothing about the\nrelease, the modules or the technology in use, and requires no\nauthentication.",
                "summary": "Service status",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}