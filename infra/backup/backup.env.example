# The backup settings of one school (D-112). Copy to /etc/acadly/sunrise.backup.env, chmod 600,
# owned by the school's user. Used by acadly-backup.sh and acadly-restore.sh.
SCHOOL=sunrise
APP_DIR=/srv/acadly/sunrise/shared
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=acadly_sunrise
# The owner role: it can read every table, and restore into an empty database.
PGUSER=acadly_owner
PGPASSWORD=
BACKUP_DIR=/var/backups/acadly
# An rclone remote and folder off this server, for example a bucket with object lock.
OFFSITE=offsite:acadly/sunrise
KEEP_DAILY=14
